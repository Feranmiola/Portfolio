# Quickest free option: web3forms.com emails every "Start a project" submission
# to the inbox you register there. Paste the access key they send you.
WEB3FORMS_ACCESS_KEY=

# Alternative: any URL that accepts the submission as JSON (Make/n8n webhook,
# Discord webhook, your own API). Ignored when WEB3FORMS_ACCESS_KEY is set.
CONTACT_WEBHOOK_URL=
